{
  "name": "@moonsjs/cli",
  "version": "0.2.1",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonsjs/cli.git"
  },
  "homepage": "https://github.com/moonsjs/docs",
  "bugs": {
    "url": "https://github.com/moonsjs/cli/issues"
  },
  "files": [
    "dist",
    "src",
    "template",
    "docs"
  ],
  "bin": {
    "moons": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prepack": "bun run build",
    "build": "rm -rf dist && tsc -p tsconfig.json --emitDeclarationOnly && bun build src/index.ts src/cli.ts --outdir dist --target node --format esm --splitting --sourcemap=external --external @moonsjs/core --external '@moonsjs/core/*' --external @moonsjs/vite --external '@moonsjs/vite/*' --external vite",
    "test": "bun test"
  },
  "dependencies": {
    "@moonsjs/core": "^0.2.0",
    "@moonsjs/vite": "^0.2.0",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/bun": "^1.4.3"
  }
}
